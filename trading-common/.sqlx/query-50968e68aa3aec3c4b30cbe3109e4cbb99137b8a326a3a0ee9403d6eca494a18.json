  "query": "\n            SELECT \n                symbol,\n                COUNT(*) as records_count,\n                MIN(timestamp) as earliest_time,\n                MAX(timestamp) as latest_time,\n                MIN(price) as min_price,\n                MAX(price) as max_price\n            FROM tick_data\n            GROUP BY symbol\n            ORDER BY records_count DESC\n            ",
