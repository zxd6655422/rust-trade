[Unit]
Description=Trading Data Collector
Documentation=https://github.com/your-repo/rust-trade
After=network.target postgresql.service redis.service
Wants=postgresql.service redis.service

[Service]
Type=simple
User=trading
Group=trading
WorkingDirectory=/opt/trading
ExecStart=/opt/trading/bin/trading-core service
Restart=always
RestartSec=10

# 环境变量
EnvironmentFile=/opt/trading/.env

# 资源限制
LimitNOFILE=65536
LimitNPROC=4096

# 日志
StandardOutput=journal
StandardError=journal
SyslogIdentifier=trading-collector

# 安全加固
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/trading

[Install]
WantedBy=multi-user.target
