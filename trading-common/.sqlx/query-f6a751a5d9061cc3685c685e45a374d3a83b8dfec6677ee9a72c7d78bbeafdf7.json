{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT\n                COUNT(*) as total_ticks,\n                MIN(price) as min_price,\n                MAX(price) as max_price,\n                SUM(quantity) as total_volume\n            FROM tick_data\n            WHERE symbol = $1\n              AND timestamp > NOW() - INTERVAL '1 hour' * $2\n            ",
