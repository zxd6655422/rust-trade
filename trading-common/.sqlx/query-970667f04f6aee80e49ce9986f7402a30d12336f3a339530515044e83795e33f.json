  "query": "\n            SELECT timestamp, symbol, price, quantity, side, trade_id, is_buyer_maker\n            FROM tick_data \n            WHERE symbol = $1 \n            AND timestamp >= $2 \n            AND timestamp <= $3\n            ORDER BY timestamp ASC\n            LIMIT $4\n            ",
