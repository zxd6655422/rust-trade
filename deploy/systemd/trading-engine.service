[Unit]
Description=Trading Engine
Documentation=https://github.com/your-repo/rust-trade
After=network.target trading-collector.service postgresql.service redis.service
Wants=postgresql.service redis.service
Requires=trading-collector.service

[Service]
Type=simple
User=trading
Group=trading
WorkingDirectory=/opt/trading
ExecStart=/opt/trading/bin/trading-engine
Restart=always
RestartSec=10

# 环境变量
EnvironmentFile=/opt/trading/.env

# 资源限制
LimitNOFILE=65536
LimitNPROC=4096

# 日志
StandardOutput=journal
StandardError=journal
SyslogIdentifier=trading-engine

# 安全加固
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/trading

[Install]
WantedBy=multi-user.target
