# 环境变量示例
# 复制此文件为 .env 并填写实际值

# 数据库连接
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# Redis 连接
REDIS_URL=redis://:password@127.0.0.1:6379

# 运行模式: development, test, production
RUN_MODE=development

# 交易所 API 配置
# 环境变量名格式：{exchange_config.id 大写，- 替换为 _}_API_KEY / _API_SECRET / _PASSPHRASE

# Binance 合约
BINANCE_FUTURES_API_KEY=your_api_key_here
BINANCE_FUTURES_API_SECRET=your_api_secret_here

# Binance 现货
BINANCE_SPOT_API_KEY=your_api_key_here
BINANCE_SPOT_API_SECRET=your_api_secret_here

# OKX 合约 (需要 passphrase)
OKX_FUTURES_API_KEY=your_api_key_here
OKX_FUTURES_API_SECRET=your_api_secret_here
OKX_FUTURES_PASSPHRASE=your_passphrase_here

# OKX 现货 (需要 passphrase)
OKX_SPOT_API_KEY=your_api_key_here
OKX_SPOT_API_SECRET=your_api_secret_here
OKX_SPOT_PASSPHRASE=your_passphrase_here
